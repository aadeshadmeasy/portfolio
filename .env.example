# Public environment variables

NEXT_PUBLIC_SITE_URL=https://aadeshpanwar.com
NEXT_PUBLIC_CONTACT_EMAIL=aadesh.panwar@admeasy.in
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/aadesh-panwar/

# Calendly — primary scheduling (shown in Daily Transmission + Calendar app)
# Example: https://calendly.com/your-username/30min
NEXT_PUBLIC_CALENDLY_URL=

# Optional: Cal.com or other embed (used if Calendly URL is empty)
NEXT_PUBLIC_CALENDAR_EMBED_URL=
NEXT_PUBLIC_BOOKING_URL=

# Google Calendar API (server-side booking + Google Meet invites — optional fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=aadesh.panwar@admeasy.in
OWNER_EMAIL=aadesh.panwar@admeasy.in

# Calendly API (optional — for future server-side webhooks; not required for embed)
CALENDLY_API_KEY=
CALENDLY_WEBHOOK_SIGNING_KEY=
